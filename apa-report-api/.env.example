# APA Report Generator API - configuration
# Copy to .env and fill in the values marked REQUIRED. Never commit .env.

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (empty = CORS disabled)
CORS_ALLOW_ORIGINS=
# Base URI for the `type` field of Problem Details responses
PROBLEM_TYPE_BASE_URL=https://api.example.com/problems

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://apa:apa@localhost:5432/apa_reports
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis (REQUIRED) --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- AWS (SQS + S3). Set AWS_ENDPOINT_URL for LocalStack; leave empty for AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- SQS (REQUIRED queue URLs) -----------------------------------------------
SQS_PLANNING_QUEUE_URL=http://localhost:4566/000000000000/apa-planning
SQS_GENERATION_QUEUE_URL=http://localhost:4566/000000000000/apa-generation
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_HEARTBEAT_SECONDS=60
# Must match maxReceiveCount in the queues' redrive policy
SQS_MAX_RECEIVE_COUNT=5

# --- S3 (REQUIRED bucket) ----------------------------------------------------
S3_EXPORTS_BUCKET=apa-report-exports
S3_PRESIGN_TTL_SECONDS=900

# --- Auth (JWT bearer) -------------------------------------------------------
# HS256/HS384/HS512 use JWT_SECRET; RS*/ES*/PS* use JWT_JWKS_URL.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-to-a-long-random-string
JWT_JWKS_URL=
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=apa-report-api
JWT_LEEWAY_SECONDS=30

# --- Request handling --------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400
MAX_ACTIVE_REPORTS_PER_USER=3
# Per-user limit on POST /reports: RATE_LIMIT_REQUESTS per RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Retry-After sent when MAX_ACTIVE_REPORTS_PER_USER is exceeded
ACTIVE_LIMIT_RETRY_AFTER_SECONDS=60
OUTBOX_RELAY_INTERVAL_SECONDS=5
OUTBOX_RELAY_BATCH_SIZE=50
SSE_KEEPALIVE_SECONDS=15

# --- Workers -----------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- OpenAlex ----------------------------------------------------------------
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_TIMEOUT_SECONDS=30
OPENALEX_SEMANTIC_RPS=1
OPENALEX_CACHE_TTL_SECONDS=86400
OPENALEX_PER_PAGE=25

# --- LLM ---------------------------------------------------------------------
# anthropic = Claude via the Anthropic SDK; fake = deterministic offline stub (dev/tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-opus-5-5
LLM_SCREENING_MODEL=claude-haiku-4-5
LLM_WRITING_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=16000
# Sent only to models that accept sampling parameters (Claude Opus 5.5 rejects them)
LLM_TEMPERATURE=0.2
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=4

# --- Pipeline ----------------------------------------------------------------
MIN_PAPERS_PER_SUBQUESTION=5
MAX_RETRIEVAL_ROUNDS=3
MAX_CANDIDATES_PER_SUBQUESTION=40
RETRIEVAL_EXPANSION_SEEDS=5
SCREENING_BATCH_SIZE=10
MIN_INCLUDED_PAPERS=3
